# -----------------------------------------------------------------------------
# Docker Compose (profiles: core | obs | quality — comma-separated)
# Example: COMPOSE_PROFILES=core
# Example: COMPOSE_PROFILES=core,obs   # add Langfuse
# Example: COMPOSE_PROFILES=core,obs,quality   # entire lab
COMPOSE_PROFILES=core

# -----------------------------------------------------------------------------
# GCP / Gemini (Vertex AI + google-genai; no Gemini API keys)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_GENERATIVE_MODEL=gemini-2.0-flash
VERTEX_EMBEDDING_MODEL=text-embedding-004

# Phase 1 RAG (Streamlit: ingest PDFs via **upload** only in the UI).
RAG_QDRANT_COLLECTION=ifc_annual_report_chunks
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# Phase 3 · Hybrid retrieval — ON by default (set RAG_HYBRID_ENABLED=false for dense-only FAISS).
# RAG_HYBRID_ENABLED=false
# RAG_HYBRID_DENSE_POOL=24
# RAG_HYBRID_SPARSE_POOL=24
# RAG_RRF_K=60
# RRF leg weights (defaults 1.0 / 1.0). Raise sparse for lexical/recall emphasis, e.g. 1.15.
# RAG_RRF_DENSE_WEIGHT=1.0
# RAG_RRF_SPARSE_WEIGHT=1.0
# Optional 1-based inclusive PDF page bounds (combine with inline "pages 10-20" in questions).
# RAG_PAGE_FILTER_MIN=
# RAG_PAGE_FILTER_MAX=
# Lexical metadata boost before optional cross-encoder pass.
# RAG_METADATA_BOOST_ENABLED=true
# Cross-encoder (install Torch stack: uv sync --extra phase3). Example:
# RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_CROSS_ENCODER_TOP_N=24
# Eval reports redact FAISS paths to basename by default; avoid enabling when sharing artifacts:
# RAG_EVAL_SNAPSHOT_INCLUDE_ABSOLUTE_PATHS=false

# Phase 4 · Semantic cache & multi-hop — ON by default (set false to disable).
# Cache is partitioned by (resolved FAISS path, Qdrant collection), not per PDF/session—
# disable semantic cache on shared multi-tenant Streamlit unless indices are isolated per tenant.
# RAG_SEMANTIC_CACHE_ENABLED=false
# RAG_SEMANTIC_CACHE_PATH=./data/semantic_rag_cache.json  # per-corpus files: stem_<hash>.json
# RAG_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
# RAG_SEMANTIC_CACHE_MAX_ENTRIES=256
# RAG_MULTI_HOP_ENABLED=false

# Vertex embed_content: max 250 texts per request and ~20k total input tokens per request.
# RAG_EMBEDDING_BATCH_SIZE=250
# RAG_EMBEDDING_MAX_INPUT_TOKENS=18000
# Docker Compose mounts host ADC into `rag-app` by default (see `GCP_ADC_HOST_PATH` in docker-compose).
# After `gcloud auth application-default login`, the file usually lives at:
#   ~/.config/gcloud/application_default_credentials.json
# Uncomment only if you need a non-default host path:
# GCP_ADC_HOST_PATH=/custom/path/to/application_default_credentials.json
#
# Service-account JSON instead of ADC (set env + matching volume in compose):
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# -----------------------------------------------------------------------------
# Vector DB + local indices
# -----------------------------------------------------------------------------
# Streamlit on the host (uv run …): Qdrant exposed on localhost from compose `ports:` or a local binary.
QDRANT_URL=http://localhost:6333
#
# docker-compose `rag-app` does **not** reuse QDRANT_URL from this file for container networking — it sets
# QDRANT_URL inside the container from QDRANT_DOCKER_URL (default http://qdrant:6333, the sibling service).
# Override only if Qdrant is elsewhere from the app container's point of view (e.g. host.docker.internal).
# QDRANT_DOCKER_URL=http://qdrant:6333
FAISS_STORE_PATH=./data/faiss

# -----------------------------------------------------------------------------
# Langfuse ingestion (populate after onboarding in Langfuse UI)
# Phase 1 RAG: traces send query length + SHA-256 only (no raw question text); restrict project access and retention for regulated data.
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=generate-a-long-secret
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
LANGFUSE_SALT=replace-with-random-salt
LANGFUSE_REDIS_AUTH=changeme-langfuse-redis
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
MINIO_SECRET=miniosecret
